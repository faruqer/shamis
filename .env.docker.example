# Copy to .env before running:  cp .env.docker.example .env

JWT_SECRET=change-this-to-a-long-random-string

# SQLite file inside the Docker volume (do not change unless you know why)
DATABASE_URL=file:/data/dev.db

# Set true when serving over HTTPS (domain + nginx)
COOKIE_SECURE=false

# Create admin on first start (recommended for a fresh server)
SEED_ADMIN=true
ADMIN_EMAIL=admin@stockmoney.com
ADMIN_PASSWORD=change-this-admin-password

# --- Domain + HTTPS (nginx + Let's Encrypt certbot) ---
DOMAIN=yourdomain.com
ACME_EMAIL=you@yourdomain.com
# Use 1 for test certificates first (optional)
CERTBOT_STAGING=0
