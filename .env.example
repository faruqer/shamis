# Use an absolute path on the server so the app always opens the same database file.
# Example (Windows): DATABASE_URL="file:D:/apps/Stock and Money/prisma/dev.db"
DATABASE_URL="file:./dev.db"

# REQUIRED in production: random, at least 32 characters. The app refuses to run with this example value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Optional: force session cookie Secure flag (default follows request http/https)
# COOKIE_SECURE=false

# Optional: send Strict-Transport-Security. Only enable when the app is served over HTTPS —
# once a browser sees it, plain-http access to the same host is refused for a year.
# HSTS=true

# Port and interface the app listens on (read by ecosystem.config.js).
# Behind nginx: PORT=3000 and HOST=127.0.0.1. Serving directly on port 80: see DEPLOY.md.
PORT=3000
HOST=0.0.0.0
